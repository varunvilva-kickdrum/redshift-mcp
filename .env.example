# Redshift connection
REDSHIFT_HOST=your-cluster.xxxxxx.region.redshift.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_DATABASE=your_database
REDSHIFT_USER=your_username
REDSHIFT_PASSWORD=your_password
# On AWS Lambda, prefer Secrets Manager ARN instead of a literal password in env:
# REDSHIFT_PASSWORD_SECRET_ARN=arn:aws:secretsmanager:region:account:secret:name

# Optional: IAM auth instead of password (leave blank if using password)
REDSHIFT_IAM=false
REDSHIFT_CLUSTER_IDENTIFIER=
REDSHIFT_AWS_REGION=

# Safety limits
MAX_ROWS_RETURNED=10000
QUERY_TIMEOUT_SECONDS=60
DEFAULT_SCHEMA=public

# Optional: comma-separated allowlist of schemas. If empty, all readable schemas allowed.
ALLOWED_SCHEMAS=

# Optional: comma-separated denylist of schemas (e.g., schemas with PII)
BLOCKED_SCHEMAS=pii,sensitive

# --- MCP transport (stdio = Claude Desktop local; streamable-http = remote URL) ---
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_STATELESS_HTTP=false
MCP_JSON_RESPONSE=true
# Tier used when no JWT is present (local stdio). free | premium | analyst
MCP_LOCAL_DEV_TIER=analyst
# Relax Host/Origin checks (local only; do not use on public ALB)
MCP_RELAX_TRANSPORT_SECURITY=false
# Comma-separated allowlists for streamable HTTP (set to your ALB DNS:port and browser origins)
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=

# Auth0 (required for authenticated streamable HTTP)
AUTH0_DOMAIN=
# For remote MCP, set to the same value as MCP_PUBLIC_URL (including /mcp path).
AUTH0_AUDIENCE=
AUTH0_TIER_CLAIM=https://redshift-mcp/tier
# Public MCP URL clients use (must match AUTH0_AUDIENCE and Auth0 API identifier).
MCP_PUBLIC_URL=

# Rate limiting: leave blank for in-process counters; set both for DynamoDB (shared across Lambda invocations)
RATE_LIMIT_DYNAMODB_TABLE=
RATE_LIMIT_AWS_REGION=

# Tool result cache size (entries)
MCP_CACHE_MAX_ENTRIES=512
